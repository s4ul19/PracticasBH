Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Obtiene", " ", "y", " ", "ordena", " ", "la", " ", "lista", " ", "en", " ",
     "un", " ", "solo", " ", "paso"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"archivos", " ", "=", " ", 
     RowBox[{"SortBy", "[", 
      RowBox[{
       RowBox[{"FileNames", "[", 
        RowBox[{"\"\<*Sym.csv\>\"", ",", " ", "dir"}], "]"}], ",", " ", "\n", 
       "   ", 
       RowBox[{
        RowBox[{"ToExpression", " ", "@", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"StringCases", "[", 
           RowBox[{
            RowBox[{"FileNameTake", "[", "#", "]"}], ",", " ", 
            RowBox[{"DigitCharacter", " ", ".."}]}], "]"}]}]}], " ", "&"}]}], 
      "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Importa", " ", "los", " ", "datos"}], " ", "*)"}], "\n", 
   RowBox[{
